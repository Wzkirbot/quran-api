{
  "name": "quran-api",
  "version": "1.0.0",
  "description": "Free, Open Source & Self-Hosted Quran, Adhkar and Islamic REST API for developers with Zero External Runtime Dependency.",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "validate:data": "tsx scripts/validate-data.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/importers/ingest.ts",
    "import:all": "tsx scripts/importers/cli.ts --all",
    "import:quran": "tsx scripts/importers/cli.ts --quran",
    "import:adhkar": "tsx scripts/importers/cli.ts --adhkar",
    "import:dua": "tsx scripts/importers/cli.ts --dua",
    "import:tafsir": "tsx scripts/importers/cli.ts --tafsir",
    "guard:offline": "tsx scripts/guard-no-external-calls.ts",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "quran",
    "quran-api",
    "islamic-api",
    "adhkar",
    "dua",
    "tafsir",
    "self-hosted",
    "offline-first",
    "typescript",
    "postgresql",
    "open-source"
  ],
  "author": "Quran API Open Source Community",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "lru-cache": "^10.2.0",
    "pg": "^8.11.5",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "swagger-ui-express": "^5.0.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/yamljs": "^0.2.34",
    "jest": "^29.7.0",
    "pino-pretty": "^11.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
