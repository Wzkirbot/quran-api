# ==========================================
# Quran API - Environment Configuration
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://quran_user:quran_pass@localhost:5432/quran_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# Optional Redis Cache (Leave blank or omit to use built-in In-Memory LRU Cache)
REDIS_URL=

# Cache TTL Configuration (in seconds)
CACHE_TTL_DEFAULT=3600
CACHE_TTL_SURAHS=86400
CACHE_TTL_SEARCH=1800

# Rate Limiting
# Rate limit window: 1m, 15m, 1h
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_MAX=100

# CORS Configuration
# Use comma-separated origins or * for all
CORS_ORIGIN=*

# Logging Configuration (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# API Key Protection (Optional - set to true to enforce API Key for /v1 routes)
REQUIRE_API_KEY=false
